{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/erduo1998-cell/erduo-broll-loop-engineering/blob/main/erduo-broll-loop-engineering/references/runtime/presenter-edit-plan.schema.json",
  "title": "Presenter and B-roll edit decision list",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "authoredBy", "compositionScope", "runtimePlan", "presenterSource", "recipes", "output", "segments"],
  "properties": {
    "schemaVersion": { "enum": ["2.0.0", "3.0.0"] },
    "authoredBy": { "const": "compiled-from-recipe-creative-proposals" },
    "compositionScope": { "enum": ["framework-demo", "canary", "full-production"] },
    "runtimePlan": { "$ref": "#/$defs/boundFile" },
    "presenterSource": { "$ref": "#/$defs/presenterSourceBinding" },
    "presentationMode": { "enum": ["original", "avatar-center", "avatar-split"] },
    "presentationModeContract": { "$ref": "#/$defs/boundFile" },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shotId", "file", "recipeIdentity", "truthIdentity"],
        "properties": {
          "shotId": { "$ref": "#/$defs/id" },
          "file": { "type": "string", "minLength": 1 },
          "recipeIdentity": { "$ref": "#/$defs/sha256" },
          "truthIdentity": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps"],
      "properties": {
        "width": { "type": "integer", "minimum": 2 },
        "height": { "type": "integer", "minimum": 2 },
        "fps": { "type": "number", "exclusiveMinimum": 0, "maximum": 120 }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "startMs", "endMs"],
        "properties": {
          "kind": { "enum": ["presenter", "broll", "split"] },
          "shotId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "startMs": { "type": "integer", "minimum": 0 },
          "endMs": { "type": "integer", "minimum": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "type": "object", "required": ["schemaVersion"], "properties": { "schemaVersion": { "const": "3.0.0" } } },
      "then": { "type": "object", "required": ["presentationMode", "presentationModeContract"] }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "boundFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "identity"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "identity": { "$ref": "#/$defs/sha256" }
      }
    },
    "presenterSourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "mediaSha256"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mediaSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
