{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/erduo1998-cell/erduo-broll-loop-engineering/blob/main/erduo-broll-loop-engineering/references/runtime/presenter-edit-plan.schema.json",
  "title": "Presenter and B-roll edit decision list",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "output", "segments"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps"],
      "properties": {
        "width": { "type": "integer", "minimum": 2 },
        "height": { "type": "integer", "minimum": 2 },
        "fps": { "type": "number", "exclusiveMinimum": 0, "maximum": 120 }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "startMs", "endMs"],
        "properties": {
          "kind": { "enum": ["presenter", "broll"] },
          "shotId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "startMs": { "type": "integer", "minimum": 0 },
          "endMs": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
