{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/erduo1998-cell/erduo-broll-loop-engineering/blob/main/erduo-broll-loop-engineering/references/runtime/animation-extension.schema.json",
  "title": "Verified opt-in animation extension",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "identity", "id", "kind", "status", "intent", "runtime", "designMdPolicy", "implementation", "verification", "canaryEvidence"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "identity": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "kind": { "enum": ["hyperframes-block", "hyperframes-component"] },
    "status": { "enum": ["candidate", "canary-approved", "reusable"] },
    "intent": { "type": "string", "minLength": 12 },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "version"],
      "properties": {
        "provider": { "const": "hyperframes" },
        "version": { "const": "0.7.104" }
      }
    },
    "designMdPolicy": { "const": "preserve-original" },
    "implementation": { "$ref": "#/$defs/fileBinding" },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "artifact"],
        "properties": {
          "kind": { "enum": ["check-receipt", "snapshot", "preview"] },
          "artifact": { "$ref": "#/$defs/fileBinding" }
        }
      }
    },
    "canaryEvidence": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["productionIdentity", "receipt"],
      "properties": {
        "productionIdentity": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "receipt": { "$ref": "#/$defs/fileBinding" }
      }
    }
  },
  "$defs": {
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "sha256"],
      "properties": {
        "locator": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
